{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@bank-packs": ["src/content/banks/packs.ts"] }
  },
  "include": ["src", "tests", "server", "shared", "scripts", "vite.config.ts", "playwright.config.ts", "playwright.parity.config.ts", "dojoPort.ts"]
}
