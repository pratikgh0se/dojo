{
  "name": "dojo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "server": "node server/dojo-server.mjs",
    "server:fake": "node server/dojo-server.mjs --fake",
    "dev:ai": "VITE_DOJO_AI=helper node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "install:app": "node scripts/install-app.mjs",
    "uninstall:app": "node scripts/uninstall-app.mjs",
    "desktop": "npm run build && electron .",
    "e2e:desktop": "playwright test -c playwright.desktop.config.ts",
    "db:export-pg": "node scripts/export-pg.mjs",
    "typecheck": "tsc --noEmit",
    "test": "TZ=Asia/Kolkata NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "TZ=Asia/Kolkata NODE_OPTIONS=--no-experimental-webstorage vitest",
    "e2e": "playwright test",
    "engines": "node scripts/vendor-engines.mjs",
    "helper:gen": "node scripts/build-helper-shared.mjs",
    "helper": "node server/helper.mjs",
    "helper:fake": "node server/helper.mjs --fake",
    "smoke:real": "node scripts/smoke-real-claude.mjs",
    "css:check": "node scripts/css-collisions.mjs",
    "bundle:check": "node scripts/bundle-check.mjs",
    "parity:today": "playwright test -c playwright.parity.config.ts today.parity",
    "parity:today:update": "UPDATE_PARITY=1 playwright test -c playwright.parity.config.ts today.parity",
    "parity:ai": "playwright test -c playwright.parity.config.ts ai.parity",
    "parity:ai:update": "UPDATE_PARITY=1 playwright test -c playwright.parity.config.ts ai.parity",
    "parity:labs": "playwright test -c playwright.parity.config.ts labs.parity",
    "parity:labs:update": "UPDATE_PARITY=1 playwright test -c playwright.parity.config.ts labs.parity",
    "parity:designs": "playwright test -c playwright.parity.config.ts designs.parity",
    "parity:designs:update": "UPDATE_PARITY=1 playwright test -c playwright.parity.config.ts designs.parity"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^1.1.7",
    "pyodide": "0.29.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
